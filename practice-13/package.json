{
  "name": "practice-13",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test ./checks/*.test.js ./tests/unit/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=75 ./checks/*.test.js ./tests/unit/*.test.js",
    "lint": "eslint src checks tests tools",
    "format": "prettier --write src checks tests tools *.js",
    "format:check": "prettier --check src checks tests tools *.js",
    "check:markers": "node tools/check-test-markers.mjs",
    "quality": "npm test && npm run test:coverage && npm run lint && npm run format:check && npm run check:markers"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2"
  }
}
